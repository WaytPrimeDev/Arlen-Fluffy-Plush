{
    "version": 2,
    "rewrites": [
      {
        "source": "/api/:path*",
        "destination": "https://arlenback-production.up.railway.app/:path*"
      }
    ],
    "headers": [
      {
        "source": "/assets/(.*)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }